{
  "name": "@localchat/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "LocalChat Tauri 2 desktop shell",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run build:backend && npm run build:frontend && tauri build",
    "build:backend": "npm run build -w shared && npm run build -w server",
    "build:frontend": "npm run build -w client",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File ./scripts/build-sidecar.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7"
  }
}
